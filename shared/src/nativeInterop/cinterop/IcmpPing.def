package = com.yuroyami.pingy.native.icmp
language = C

# The protocol itself lives in shared/native/icmp_core.h, which the Android and
# JVM JNI wrapper (shared/native/icmp_ping.c) includes as well. Both platforms
# therefore share one packet format, checksum, parser and socket lifecycle.
# The include path is supplied by the cinterop block in shared/build.gradle.kts.
---
#include "icmp_core.h"

/* Thin named wrappers. cinterop exports these into Kotlin; the core stays
 * JNI-free and platform-neutral. */

static inline int open_icmp_socket_connected(const char *ipv4) {
    return pingy_open_socket(ipv4);
}

static inline void close_icmp_socket(int fd) {
    pingy_close_socket(fd);
}

static inline int64_t icmp_send_probe(int fd, int64_t session, int seq, int payload_size) {
    return pingy_send_probe(fd, session, seq, payload_size);
}

static inline int64_t icmp_await_reply(int fd, int64_t session, int budget_ms) {
    return pingy_await_reply(fd, session, budget_ms);
}

static inline int resolve_host(const char *hostname, char *ip_buf, int ip_buf_size) {
    return pingy_resolve_host(hostname, ip_buf, ip_buf_size);
}
